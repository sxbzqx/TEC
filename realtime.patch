diff --git a/tecAPI/tecBackend/Services/PortalNotifier.cs b/tecAPI/tecBackend/Services/PortalNotifier.cs
new file mode 100644
index 0000000..e783e7c
--- /dev/null
+++ b/tecAPI/tecBackend/Services/PortalNotifier.cs
@@ -0,0 +1,103 @@
+using Microsoft.AspNetCore.SignalR;
+using tecBackend.Hubs;
+using tecBackend.Utils;
+
+namespace tecBackend.Services;
+
+/// <summary>Темы, по которым клиент перезапрашивает данные. Должны совпадать с tec_client/utils/realtime.ts.</summary>
+public static class RealtimeTopics
+{
+    public const string Posts = "posts";
+    public const string Categories = "categories";
+    public const string Activity = "activity";
+    public const string Departments = "departments";
+    public const string Bids = "bids";
+    public const string Resources = "resources";
+    public const string Equipment = "equipment";
+    public const string Workers = "workers";
+    public const string Users = "users";
+
+    // Публичные данные — слушают все, включая гостей.
+    private static readonly HashSet<string> Public = [Posts, Categories, Departments];
+
+    // Персональные данные сотрудников и список аккаунтов — только админам.
+    private static readonly HashSet<string> StaffOnly = [Workers, Users];
+
+    public static bool IsPublic(string topic) => Public.Contains(topic);
+
+    public static bool IsStaffOnly(string topic) => StaffOnly.Contains(topic);
+}
+
+public interface IPortalNotifier
+{
+    /// <summary>Сообщить клиентам, что данные по темам изменились (в событии только имя темы, без данных).</summary>
+    Task PublishDataChangedAsync(IEnumerable<string> topics);
+
+    /// <summary>Сообщить пользователю, что его роль/профиль изменились (reason: role | profile).</summary>
+    Task NotifyAuthChangedAsync(int userId, string reason, string? role = null);
+
+    /// <summary>Принудительно разлогинить пользователя на всех устройствах (reason: banned | sessions | password).</summary>
+    Task ForceLogoutAsync(int userId, string reason);
+
+    /// <summary>Перевыдать группы уже открытым подключениям пользователя после смены роли.</summary>
+    Task SyncUserGroupsAsync(int userId, string role);
+}
+
+public sealed class PortalNotifier(
+    IHubContext<PortalHub> hub,
+    PresenceTracker presence,
+    ILogger<PortalNotifier> logger
+) : IPortalNotifier
+{
+    public async Task PublishDataChangedAsync(IEnumerable<string> topics)
+    {
+        foreach (var topic in topics)
+        {
+            IClientProxy audience =
+                RealtimeTopics.IsPublic(topic) ? hub.Clients.All
+                : RealtimeTopics.IsStaffOnly(topic) ? hub.Clients.Group(PortalGroups.Staff)
+                : hub.Clients.Group(PortalGroups.Members);
+
+            await SafeSendAsync(audience, PortalEvents.DataChanged, topic);
+        }
+    }
+
+    public Task NotifyAuthChangedAsync(int userId, string reason, string? role = null) =>
+        SafeSendAsync(hub.Clients.User(userId.ToString()), PortalEvents.AuthChanged, new { reason, role });
+
+    public Task ForceLogoutAsync(int userId, string reason) =>
+        SafeSendAsync(hub.Clients.User(userId.ToString()), PortalEvents.ForceLogout, new { reason });
+
+    public async Task SyncUserGroupsAsync(int userId, string role)
+    {
+        var isStaff = AppRoles.IsStaff(role);
+
+        foreach (var connectionId in presence.GetConnections(userId))
+        {
+            try
+            {
+                if (isStaff)
+                    await hub.Groups.AddToGroupAsync(connectionId, PortalGroups.Staff);
+                else
+                    await hub.Groups.RemoveFromGroupAsync(connectionId, PortalGroups.Staff);
+            }
+            catch (Exception ex)
+            {
+                logger.LogWarning(ex, "Не удалось обновить группы подключения {ConnectionId}", connectionId);
+            }
+        }
+    }
+
+    // Realtime — вторичный канал: его сбой не должен ломать основную операцию.
+    private async Task SafeSendAsync(IClientProxy proxy, string method, object? arg)
+    {
+        try
+        {
+            await proxy.SendAsync(method, arg);
+        }
+        catch (Exception ex)
+        {
+            logger.LogWarning(ex, "SignalR: не удалось отправить {Method}", method);
+        }
+    }
+}
diff --git a/tecAPI/tecBackend/Services/PresenceTracker.cs b/tecAPI/tecBackend/Services/PresenceTracker.cs
new file mode 100644
index 0000000..486f664
--- /dev/null
+++ b/tecAPI/tecBackend/Services/PresenceTracker.cs
@@ -0,0 +1,50 @@
+namespace tecBackend.Services;
+
+/// <summary>Кто сейчас онлайн: userId → connectionId'ы SignalR (у одного пользователя может быть несколько вкладок).</summary>
+public sealed class PresenceTracker
+{
+    private readonly object _gate = new();
+    private readonly Dictionary<int, HashSet<string>> _connections = new();
+
+    /// <returns>true, если это первое подключение пользователя (он только что появился в сети).</returns>
+    public bool Add(int userId, string connectionId)
+    {
+        lock (_gate)
+        {
+            if (!_connections.TryGetValue(userId, out var set))
+                _connections[userId] = set = new HashSet<string>();
+
+            set.Add(connectionId);
+            return set.Count == 1;
+        }
+    }
+
+    /// <returns>true, если подключений не осталось (пользователь вышел из сети).</returns>
+    public bool Remove(int userId, string connectionId)
+    {
+        lock (_gate)
+        {
+            if (!_connections.TryGetValue(userId, out var set))
+                return false;
+
+            set.Remove(connectionId);
+            if (set.Count > 0)
+                return false;
+
+            _connections.Remove(userId);
+            return true;
+        }
+    }
+
+    public string[] GetConnections(int userId)
+    {
+        lock (_gate)
+            return _connections.TryGetValue(userId, out var set) ? [.. set] : [];
+    }
+
+    public HashSet<int> OnlineUserIds()
+    {
+        lock (_gate)
+            return [.. _connections.Keys];
+    }
+}
diff --git a/tecAPI/tecBackend/Services/RealtimeSaveChangesInterceptor.cs b/tecAPI/tecBackend/Services/RealtimeSaveChangesInterceptor.cs
new file mode 100644
index 0000000..1668e0e
--- /dev/null
+++ b/tecAPI/tecBackend/Services/RealtimeSaveChangesInterceptor.cs
@@ -0,0 +1,124 @@
+using System.Runtime.CompilerServices;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.EntityFrameworkCore.Diagnostics;
+using tecBackend.Models;
+
+namespace tecBackend.Services;
+
+/// <summary>
+/// Побочные эффекты успешного SaveChanges:
+///  • по изменённым сущностям определяет темы и рассылает DataChanged — контроллерам ничего делать не нужно;
+///  • при изменении User сбрасывает кэш роли/бана, чтобы старый JWT перестал работать сразу.
+/// События уходят только ПОСЛЕ успешного сохранения, поэтому клиент не успеет запросить старые данные.
+/// </summary>
+public sealed class RealtimeSaveChangesInterceptor(
+    IPortalNotifier notifier,
+    IUserAuthStateService authState
+) : SaveChangesInterceptor
+{
+    private sealed record Pending(HashSet<string> Topics, HashSet<int> UserIds);
+
+    // Перехватчик — singleton, а контекстов много, поэтому состояние хранится на каждый контекст отдельно.
+    private readonly ConditionalWeakTable<DbContext, Pending> _pending = new();
+
+    private static readonly Dictionary<Type, string> TopicByEntity = new()
+    {
+        [typeof(Post)] = RealtimeTopics.Posts,
+        [typeof(Category)] = RealtimeTopics.Categories,
+        [typeof(ActivityLog)] = RealtimeTopics.Activity,
+        [typeof(Otdel)] = RealtimeTopics.Departments,
+        [typeof(Document)] = RealtimeTopics.Bids,
+        [typeof(Resource)] = RealtimeTopics.Resources,
+        [typeof(OfficeEquipment)] = RealtimeTopics.Equipment,
+        [typeof(Worker)] = RealtimeTopics.Workers,
+        [typeof(User)] = RealtimeTopics.Users,
+    };
+
+    private void Capture(DbContext? context)
+    {
+        if (context is null)
+            return;
+
+        var topics = new HashSet<string>();
+        var userIds = new HashSet<int>();
+
+        foreach (var entry in context.ChangeTracker.Entries())
+        {
+            if (entry.State is not (EntityState.Added or EntityState.Modified or EntityState.Deleted))
+                continue;
+
+            if (TopicByEntity.TryGetValue(entry.Entity.GetType(), out var topic))
+                topics.Add(topic);
+
+            if (entry.Entity is User user && entry.State != EntityState.Added)
+                userIds.Add(user.Id);
+        }
+
+        if (topics.Count > 0 || userIds.Count > 0)
+            _pending.AddOrUpdate(context, new Pending(topics, userIds));
+    }
+
+    private async Task FlushAsync(DbContext? context)
+    {
+        if (context is null || !_pending.TryGetValue(context, out var pending))
+            return;
+
+        _pending.Remove(context);
+
+        foreach (var userId in pending.UserIds)
+            authState.Invalidate(userId);
+
+        if (pending.Topics.Count > 0)
+            await notifier.PublishDataChangedAsync(pending.Topics);
+    }
+
+    public override InterceptionResult<int> SavingChanges(
+        DbContextEventData eventData,
+        InterceptionResult<int> result
+    )
+    {
+        Capture(eventData.Context);
+        return result;
+    }
+
+    public override ValueTask<InterceptionResult<int>> SavingChangesAsync(
+        DbContextEventData eventData,
+        InterceptionResult<int> result,
+        CancellationToken cancellationToken = default
+    )
+    {
+        Capture(eventData.Context);
+        return ValueTask.FromResult(result);
+    }
+
+    public override int SavedChanges(SaveChangesCompletedEventData eventData, int result)
+    {
+        FlushAsync(eventData.Context).GetAwaiter().GetResult();
+        return result;
+    }
+
+    public override async ValueTask<int> SavedChangesAsync(
+        SaveChangesCompletedEventData eventData,
+        int result,
+        CancellationToken cancellationToken = default
+    )
+    {
+        await FlushAsync(eventData.Context);
+        return result;
+    }
+
+    public override void SaveChangesFailed(DbContextErrorEventData eventData)
+    {
+        if (eventData.Context is { } context)
+            _pending.Remove(context);
+    }
+
+    public override Task SaveChangesFailedAsync(
+        DbContextErrorEventData eventData,
+        CancellationToken cancellationToken = default
+    )
+    {
+        SaveChangesFailed(eventData);
+        return Task.CompletedTask;
+    }
+}
