diff a/nginx/nginx.conf b/nginx/nginx.conf	(rejected hunks)
@@ -11,6 +11,12 @@ http {
     sendfile        on;
     keepalive_timeout 65;
 
+    # Для WebSocket (SignalR): Upgrade только если клиент его запросил
+    map $http_upgrade $connection_upgrade {
+        default upgrade;
+        ''      close;
+    }
+
     # 1. Редирект с HTTP (80) на HTTPS (443)
     server {
         listen       80;
@@ -50,6 +56,25 @@ http {
             proxy_set_header X-Forwarded-Proto $scheme;
         }
 
+        # SignalR (WebSocket) — realtime-обновления. Должен идти до общих /api/ и /
+        location /hubs/ {
+            proxy_pass http://tec_api:8080;
+            proxy_http_version 1.1;
+
+            proxy_set_header Upgrade $http_upgrade;
+            proxy_set_header Connection $connection_upgrade;
+
+            proxy_set_header Host $host;
+            proxy_set_header X-Real-IP $remote_addr;
+            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
+            proxy_set_header X-Forwarded-Proto $scheme;
+
+            # WebSocket живёт долго — не рвём его по умолчанию через 60 секунд
+            proxy_read_timeout 1h;
+            proxy_send_timeout 1h;
+            proxy_buffering off;
+        }
+
         # Бэкенд API без auth
         location ~ ^/api/(?!auth/) {
             proxy_pass http://tec_api:8080;
